.user-center-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 60rpx;
  background-color: #f6f7fb;
}

/* 顶部会员卡片 */
.member-header-card {
  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  color: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 185, 129, 0.2);
  margin-bottom: 24rpx;
}

.member-avatar-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #ffffff;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  flex-shrink: 0;
}

.member-meta {
  flex: 1;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.member-nick {
  font-size: 34rpx;
  font-weight: 700;
}

.member-tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.shop-badge-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.badge-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 订单大卡片 */
.order-dashboard-card {
  padding: 30rpx 24rpx;
}

.dash-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
  margin-bottom: 24rpx;
}

.dash-main-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.dash-all-link {
  font-size: 24rpx;
  color: #059669;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.order-grid {
  display: flex;
  justify-content: space-between;
}

.order-tab-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.tab-icon {
  font-size: 42rpx;
  margin-bottom: 8rpx;
}

.tab-label {
  font-size: 22rpx;
  color: #475569;
  font-weight: 500;
}

/* 服务列表卡片 */
.service-actions-card {
  padding: 24rpx 0 8rpx;
}

.card-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  padding: 0 28rpx 16rpx;
  border-bottom: 1rpx solid #f8fafc;
}

.action-row-btn {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  padding: 24rpx 28rpx;
  border: none;
  border-bottom: 1rpx solid #f8fafc;
  line-height: 1.4;
}

.action-row-btn::after {
  display: none;
}

.row-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.row-icon {
  font-size: 30rpx;
}

.row-title {
  font-size: 26rpx;
  color: #334155;
}

.row-arrow {
  color: #94a3b8;
  font-size: 32rpx;
}

/* FAQ 卡片 */
.faq-card {
  padding: 24rpx 28rpx;
}

.faq-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.q-title {
  font-size: 26rpx;
  color: #334155;
  font-weight: 600;
}

.q-arrow {
  font-size: 18rpx;
  color: #94a3b8;
  transition: transform 0.2s ease;
}

.q-arrow.open {
  transform: rotate(180deg);
  color: #059669;
}

.faq-answer {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 14rpx;
}

.a-content {
  font-size: 22rpx;
  color: #64748b;
  line-height: 32rpx;
}

/* 底部声明 */
.footer-endorsement {
  text-align: center;
  padding-top: 20rpx;
}

.e-text {
  font-size: 20rpx;
  color: #94a3b8;
}
