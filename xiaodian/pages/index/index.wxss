.home-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background-color: #f6f7fb;
}

/* 顶部店招 */
.shop-header-wrapper {
  background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  color: #ffffff;
  padding: 32rpx 28rpx 28rpx;
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 185, 129, 0.2);
}

.shop-brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.shop-avatar {
  font-size: 52rpx;
  background: rgba(255, 255, 255, 0.2);
  width: 90rpx;
  height: 90rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.shop-name {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.shop-cert {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.cert-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a7f3d0;
}

.cert-text {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 公告跑马灯 */
.notice-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
}

.notice-icon {
  font-size: 24rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #ffffff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 轮播大屏海报 */
.banner-section {
  position: relative;
  margin: -16rpx 24rpx 24rpx;
}

.banner-swiper {
  height: 320rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
}

.banner-card {
  width: 100%;
  height: 100%;
  position: relative;
}

.banner-image {
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.7) 100%);
  padding: 30rpx 24rpx 16rpx;
  color: #ffffff;
}

.banner-title {
  font-size: 30rpx;
  font-weight: 700;
}

.banner-sub {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.swiper-dots {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  display: flex;
  gap: 10rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s ease;
}

.dot.active {
  width: 28rpx;
  background: #ffffff;
}

/* 金刚区品类导航 */
.category-nav-card {
  margin: 0 24rpx 24rpx;
}

.nav-grid {
  display: flex;
  justify-content: space-between;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.nav-icon-bg {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #f0fdf4;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.1);
}

.nav-name {
  font-size: 24rpx;
  color: #4b5563;
  font-weight: 500;
}

/* 模式切换选项卡 */
.mode-tabs-wrapper {
  display: flex;
  margin: 0 24rpx 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 18rpx;
  transition: all 0.25s ease;
}

.mode-tab.active {
  background: #10b981;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.3);
}

.mode-tab .tab-title {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
}

.mode-tab.active .tab-title {
  color: #ffffff;
}

.mode-tab .tab-sub {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 4rpx;
  display: block;
}

.mode-tab.active .tab-sub {
  color: #d1fae5;
}

/* 服务承诺 */
.service-promise-card {
  margin: 0 24rpx 20rpx;
  background: #ecfdf5;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  display: flex;
  justify-content: space-between;
  border: 1rpx solid #a7f3d0;
}

.p-item {
  font-size: 20rpx;
  color: #047857;
  font-weight: 500;
}

/* 展台商品卡片 */
.showcase-stream {
  padding: 0 24rpx;
}

.product-item-card {
  border: 1rpx solid #edf2f7;
}

.product-badge-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx dashed #f1f5f9;
}

.badge-tag {
  background: #fee2e2;
  color: #ef4444;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
}

.badge-desc {
  font-size: 22rpx;
  color: #64748b;
}

.native-product-box {
  border-radius: 16rpx;
  overflow: hidden;
}

/* 小店整店模式 */
.store-home-container {
  margin: 0 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
}

/* 底栏 */
.home-footer {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.footer-text {
  font-size: 22rpx;
  color: #94a3b8;
}
